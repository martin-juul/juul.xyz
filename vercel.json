{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/en/gallery/",
      "destination": "/en/gallery"
    },
    {
      "source": "/en/gallery/:path*/",
      "destination": "/en/gallery/:path"
    },
    {
      "source": "/da/billedgalleri/",
      "destination": "/da/billedgalleri"
    },
    {
      "source": "/da/billedgalleri/:path*/",
      "destination": "/da/billedgalleri/:path"
    }
  ],
  "rewrites": [
    {
      "source": "/en/gallery/:album",
      "destination": "/en/gallery/index.html"
    },
    {
      "source": "/en/gallery/:album/:image",
      "destination": "/en/gallery/index.html"
    },
    {
      "source": "/da/billedgalleri/:album",
      "destination": "/da/billedgalleri/index.html"
    },
    {
      "source": "/da/billedgalleri/:album/:image",
      "destination": "/da/billedgalleri/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
